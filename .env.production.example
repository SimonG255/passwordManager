NODE_ENV=production
HOST=0.0.0.0
PORT=3001
APP_ORIGIN=https://vault.example.com
RP_ID=vault.example.com
# Provision a restricted runtime role using prisma/runtime-grants.sql.
DATABASE_URL=postgresql://vaultline_app:REPLACE_WITH_RUNTIME_SECRET@PRIVATE_DB_HOST:5432/vaultline
# Only for a separately scheduled maintenance job, never exposed to the browser.
MAINTENANCE_DATABASE_URL=postgresql://MAINTENANCE_ROLE:REPLACE_WITH_MAINTENANCE_SECRET@PRIVATE_DB_HOST:5432/vaultline
