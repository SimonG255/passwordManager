generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id        String   @id @default(uuid()) @db.Uuid
  handle    String   @unique
  createdAt DateTime @default(now())
  passkeys  Passkey[]
  sessions  Session[]
  vault     Vault?
  events    SecurityEvent[]
}

model Passkey {
  id         String   @id
  accountId  String   @db.Uuid
  publicKey  Bytes
  counter    BigInt   @default(0)
  transports String[]
  name       String
  createdAt  DateTime @default(now())
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  @@index([accountId])
}

model Challenge {
  id        String   @id
  value     String
  kind      String
  handle    String?
  accountId String?
  sessionId String?
  expiresAt DateTime
  @@index([expiresAt])
}

model Session {
  id          String   @id
  accountId   String   @db.Uuid
  csrf        String
  verifiedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  expiresAt   DateTime
  device      String
  account     Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  @@index([accountId])
  @@index([expiresAt])
}

model Vault {
  id          String   @id @db.Uuid
  accountId   String   @unique @db.Uuid
  envelope    Json
  keyVersion  Int      @default(1)
  generation  Int      @default(0)
  createdAt   DateTime @default(now())
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  entries     Entry[]
}

model Entry {
  id        String   @id @db.Uuid
  vaultId   String   @db.Uuid
  revision  Int
  envelope  Json
  updatedAt DateTime @default(now()) @updatedAt
  vault     Vault    @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  @@index([vaultId])
}

model SecurityEvent {
  id        String   @id @default(uuid()) @db.Uuid
  accountId String   @db.Uuid
  action    String
  createdAt DateTime @default(now())
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  @@index([accountId, createdAt])
}
